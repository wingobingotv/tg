# WingoBingo Telegram Mini App. Copy to .env next to docker-compose.yml.
# Everything below is read when the container starts (no rebuild needed),
# except the OPENAI_* build values at the end.
# The bot token is NOT configured here: it lives only in the Player API
# (backend) .env as TELEGRAM_BOT_TOKEN.

# Host address and port the container is published on. Keep 127.0.0.1 and put
# the host nginx in front of it: https://tg.wingobingo.tv
# (site file deploy/nginx/tg.wingobingo.tv proxies to 127.0.0.1:7400).
MINIAPP_BIND=127.0.0.1
MINIAPP_PORT=7400

# Player API, the same one the website uses. https only.
PLAYER_API_URL=https://v2.api.wingobingo.tv

# Public website, for links that leave Telegram. https only.
SITE_URL=https://wingobingo.tv

# Bot username without @ (from @BotFather), used for share and referral links.
TELEGRAM_BOT_USERNAME=

# Mini App short name from @BotFather (the <app> in t.me/<bot>/<app>). Optional.
TELEGRAM_MINIAPP_SHORT_NAME=

# Language when Telegram reports none the app supports: en | ar | fa | fr
DEFAULT_LANG=en

# Optional Live Debug telemetry (Admin Panel → Development → Live Debug).
# Same ingest endpoint and key the website uses; leave empty to disable.
DEBUG_TELEMETRY_URL=
DEBUG_TELEMETRY_KEY=

# Google reCAPTCHA v3 site key: the SAME public key as the website
# (NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY in WingoBingo/.env). Sign-in and sign-up then
# send a reCAPTCHA token, verified by the Player API with RECAPTCHA_V3_SECRET.
# The key's domain list in the reCAPTCHA admin must include tg.wingobingo.tv
# (wingobingo.tv covers it). Empty = the old image captcha.
RECAPTCHA_V3_SITE_KEY=

# LiveKit WebSocket URL of the live shows: the SAME value as the website's
# NEXT_PUBLIC_LIVEKIT_WS_URL, e.g. wss://<project>.livekit.cloud (no path).
# Viewer tokens come from the Player API (/live/viewer-token), which needs
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET / LIVEKIT_URL in backend/.env.
# Empty = no live video in the app; draws and results still show.
LIVEKIT_WS_URL=

# Build time only: native-tone ar/fa/fr copy (scripts/i18n-native-translate.mjs).
# Empty keeps the committed translations; the build never fails on it.
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=
