# Host nginx site for the Mini App (same pattern as backend/nginx/v2.api.wingobingo.tv).
# HTTP only — Certbot adds the SSL blocks after: certbot --nginx -d tg.wingobingo.tv
# Telegram opens Mini Apps only over https.
server {
    listen 80;
    server_name tg.wingobingo.tv;

    # Proxy to the Docker container (MINIAPP_BIND:MINIAPP_PORT in .env)
    location / {
        proxy_pass         http://127.0.0.1:7400;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout  10s;
        proxy_read_timeout     30s;
    }
}
